{
  "name": "@ioc/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../.env src/index.ts",
    "seed": "tsx --env-file-if-exists=../.env src/scripts/seed.ts",
    "hash-password": "tsx src/scripts/hash-password.ts",
    "collect": "tsx --env-file-if-exists=../.env src/scripts/collect.ts",
    "brief:dry": "tsx --env-file-if-exists=../.env src/scripts/not-yet.ts brief:dry M5",
    "brief:send": "tsx --env-file-if-exists=../.env src/scripts/not-yet.ts brief:send M6",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "classify": "tsx --env-file-if-exists=../.env src/scripts/classify.ts",
    "embed": "tsx --env-file-if-exists=../.env src/scripts/embed.ts",
    "cluster": "tsx --env-file-if-exists=../.env src/scripts/cluster.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/secure-session": "^8.4.2",
    "@fastify/static": "^10.1.10",
    "@ioc/shared": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.12.0",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.1",
    "tinyld": "^1.3.4",
    "undici": "^8.12.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
