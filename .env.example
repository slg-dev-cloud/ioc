# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://ioc:ioc@localhost:5432/ioc
# Used only by DB integration tests; they are skipped when unset.
TEST_DATABASE_URL=postgresql://ioc:ioc@localhost:5432/ioc_test

ANTHROPIC_API_KEY=
MODEL_CLASSIFY=claude-haiku-5-5         # verify current IDs in Anthropic docs
MODEL_SYNTHESIZE=claude-sonnet-5-5
EMBEDDING_PROVIDER=voyage               # voyage | openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=1024                      # must match the chosen model
SAM_GOV_API_KEY=
EMAIL_PROVIDER=resend                   # resend | smtp
EMAIL_API_KEY=
BRIEF_TO=
BRIEF_FROM=
# Generate with: pnpm --filter @ioc/server hash-password
OWNER_PASSWORD_HASH=
# At least 32 random characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=
PORT=3000
